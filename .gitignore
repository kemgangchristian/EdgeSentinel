# *******************************************************
# .gitignore - EdgeSentinel
# *******************************************************

# Python (agent Edge)
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
.pytest_cache/
.coverage

# Secrets et configuration locale (JAMAIS commités)
.env
.env.local
.env.*.local
*.pem
*.key

# Éditeurs de code et systèmes d'exploitation
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs 
*.log

# Modèles IA téléchargés (régénérés automatiquement)
edge/*.pt
edge/*.onnx

# --- Fichiers d'événements générés à l'exécution (edge/events.jsonl) ---
edge/events.jsonl
