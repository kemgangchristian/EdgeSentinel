# *******************************************************
# infra/jenkins/.env.example
# Template versionné - copiez-le en ".env".
# Le fichier ".env" réel est dans .gitignore, JAMAIS commité.
# Commande pour générer un mot de passe fort : `openssl rand -base64 32`
# *******************************************************

JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=changez-moi-en-un-mot-de-passe-fort
